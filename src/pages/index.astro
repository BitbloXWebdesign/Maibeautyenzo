---
import Layout from '../layouts/Layout.astro';
import treatments from '../data/treatments.json';
import products from '../data/products.json';
import reviews from '../data/reviews.json';
import faqs from '../data/faq.json';
import siteConfig from '../../public/site-config.json';

const popularTreatments = treatments.flatMap(cat => 
  cat.items.filter(i => (i as any).popular).map(i => ({ ...i, category: cat.category }))
);
const showcaseProducts = products.slice(0, 4);
---

<Layout title="Mai Beauty & zo — Luxe Schoonheidssalon & Skincare Shop in Paterswolde">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-badge">Ervaring &amp; Kwaliteit</span>
        <h1 class="hero-title">Welkom bij <span class="highlight-text">Mai Beauty &amp; zo</span></h1>
        <p class="hero-subtitle">
          Een moment voor uzelf, waar luxe, ontspanning en gerichte huidverbetering samenkomen in het karakteristieke monumentale kerkgebouw in Paterswolde.
        </p>

        <div class="hero-features">
          <div class="h-feat">
            <span class="feat-dot"></span>
            <span>Premium Behandelingen</span>
          </div>
          <div class="h-feat">
            <span class="feat-dot"></span>
            <span>Persoonlijke Aandacht</span>
          </div>
          <div class="h-feat">
            <span class="feat-dot"></span>
            <span>Dr. Baumann Cosmetica</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/contact#afspraak" class="btn btn-primary">Afspraak Inplannen</a>
          {siteConfig.modules.shop ? (
            <a href="/shop" class="btn btn-outline">Bekijk de Webshop 🛍️</a>
          ) : (
            <a href="/behandelingen" class="btn btn-outline">Bekijk Behandelingen &rarr;</a>
          )}
        </div>
      </div>

      <div class="hero-image-wrap">
        <div class="hero-img-card">
          <img src="/images/wimpers_en_wenkbrauwen.png" alt="Mai Beauty & zo salon behandeling" class="hero-img" />
          <div class="hero-floating-card">
            <span class="fl-icon">✨</span>
            <div>
              <strong>Pure Verwennerij</strong>
              <span>Paterswolde</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 1. Chique Donkere Stats Bar -->
  <section class="stats-dark-section">
    <div class="container">
      <div class="stats-dark-grid">
        <div class="stat-dark-card">
          <span class="stat-dark-num">3+</span>
          <span class="stat-dark-lbl">Jaar Ervaring</span>
        </div>
        <div class="stat-dark-card">
          <span class="stat-dark-num">500+</span>
          <span class="stat-dark-lbl">Tevreden Klanten</span>
        </div>
        <div class="stat-dark-card">
          <span class="stat-dark-num">15+</span>
          <span class="stat-dark-lbl">Behandelingen</span>
        </div>
        <div class="stat-dark-card">
          <span class="stat-dark-num">5★</span>
          <span class="stat-dark-lbl">Kwaliteit &amp; Reviews</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Pijlers Section: De Kunst van Schoonheid (Warm Cream) -->
  <section class="pillars-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Onze Filosofie</span>
        <h2 class="section-title">De Kunst van Schoonheid</h2>
        <p class="section-desc" style="max-width: 680px; margin: 0 auto;">
          Bij Mai Beauty &amp; zo combineren we traditionele massagetechnieken met moderne bionome innovatie voor een weldadige beauty-ervaring.
        </p>
      </div>

      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon-wrap">
            <span class="p-icon">💎</span>
          </div>
          <h3>Excellence in Vakmanschap</h3>
          <p>Gediplomeerd schoonheidsspecialiste met continue bijscholing in de nieuwste en meest effectieve beautytechnieken.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-icon-wrap">
            <span class="p-icon">🌿</span>
          </div>
          <h3>Natuurlijke Luxe Producten</h3>
          <p>Uitsluitend hoogwaardige, bionome producten van Dr. Baumann. Vrij van minerale oliën, conserveringsmiddelen en dierproefvrij.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-icon-wrap">
            <span class="p-icon">🕊️</span>
          </div>
          <h3>Complete Wellness Ervaring</h3>
          <p>Geniet van de rust en unieke serene sfeer in ons sfeervolle kerkgebouw. Een warm welkom met alle tijd voor u.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. Populaire Behandelingen (Helder Wit) -->
  <section class="treatments-showcase-section">
    <div class="container">
      <div class="section-header text-center">
        <span class="section-tag">Ons Behandelmenu</span>
        <h2 class="section-title">Populaire Behandelingen</h2>
        <p class="section-desc" style="max-width: 640px; margin: 0 auto;">
          Van intensieve huidverjongende gezichtsbehandelingen tot verzorgende pedicures en sprekende wimpers.
        </p>
      </div>

      <div class="treatments-grid">
        {popularTreatments.map(t => (
          <div class="treatment-card">
            <div class="treatment-header">
              <span class="treatment-cat">{t.category}</span>
              <span class="treatment-duration">⏱️ {t.duration}</span>
            </div>
            <h3 class="treatment-name">{t.name}</h3>
            <p class="treatment-desc">{t.description}</p>
            {t.highlights && (
              <ul class="treatment-hls">
                {t.highlights.map(h => (
                  <li>✓ {h}</li>
                ))}
              </ul>
            )}
            <div class="treatment-footer">
              <div class="treatment-price">
                <span class="price-lbl">Vanaf</span>
                <span class="price-val">€ {t.price}</span>
              </div>
              <a href="/contact#afspraak" class="btn btn-primary btn-sm">Afspraak Maken</a>
            </div>
          </div>
        ))}
      </div>

      <div class="treatments-cta-wrap">
        <a href="/behandelingen" class="btn btn-secondary">Bekijk Alle Behandelingen & Prijzen &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Webshop Showcase (Indien Ingeschakeld) -->
  {siteConfig.modules.shop && (
    <section class="shop-showcase-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag">Dr. Baumann & Skincare</span>
          <h2 class="section-title">Professionele Huidverzorging Webshop</h2>
          <p class="section-desc" style="max-width: 640px; margin: 0 auto;">
            Bestel uw favoriete salonproducten eenvoudig online. Afhalen in de salon of direct thuisbezorgd.
          </p>
        </div>

        <div class="products-grid">
          {showcaseProducts.map(p => (
            <div class="product-card">
              {p.tag && <span class="product-tag">{p.tag}</span>}
              <div class="product-img-wrap">
                <img src={p.image} alt={p.name} class="product-img" />
              </div>
              <div class="product-content">
                <span class="product-cat">{p.category}</span>
                <h4 class="product-title">{p.name}</h4>
                <p class="product-short">{p.shortDescription}</p>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="current-price">€ {p.price.toFixed(2).replace('.', ',')}</span>
                    {p.oldPrice && <span class="old-price">€ {p.oldPrice.toFixed(2).replace('.', ',')}</span>}
                  </div>
                  <button 
                    class="btn btn-primary btn-sm add-to-cart-btn"
                    data-id={p.id}
                    data-name={p.name}
                    data-price={p.price}
                    data-image={p.image}
                  >
                    + Winkelmand
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="shop-cta-wrap">
          <a href="/shop" class="btn btn-primary">Naar de Complete Webshop &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <!-- 4. Over Mij Sneak Peek (Warm Cream) -->
  <section class="about-preview-section">
    <div class="container about-preview-inner">
      <div class="about-img-col">
        <div class="blob-frame">
          <img src="/images/MakeUp.jpeg" alt="Aileen Smith - Schoonheidsspecialiste" class="about-portrait" />
        </div>
      </div>
      <div class="about-text-col">
        <span class="section-tag">Uw Schoonheidsspecialiste</span>
        <h2>Aileen Smith</h2>
        <p class="lead-text">
          "Mijn passie is om iedereen te laten stralen met een gezonde, verzorgde huid en een moment van diepe ontspanning."
        </p>
        <p>
          Sinds april 2021 ben ik met <strong>Mai Beauty &amp; zo</strong> gevestigd in de historische kerk aan de Hoofdweg in Paterswolde. Hier combineer ik persoonlijke aandacht met de beste bionome cosmetica van Dr. Baumann.
        </p>
        <div class="about-checklist">
          <div>✓ Gediplomeerd schoonheidsspecialiste</div>
          <div>✓ Officieel Dr. Baumann verkooppunt</div>
          <div>✓ Vaste persoonlijke behandelaar</div>
        </div>
        <div style="margin-top: 2rem;">
          <a href="/over-ons" class="btn btn-outline">Lees Mijn Verhaal &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. Chique Donkere Reviews Section -->
  {siteConfig.modules.reviews && (
    <section class="reviews-dark-section">
      <div class="container">
        <div class="section-header text-center">
          <span class="section-tag tag-dark">Ervaringen</span>
          <h2 class="section-title title-light">Wat Zeggen Onze Klanten?</h2>
          <p class="section-desc desc-light" style="max-width: 640px; margin: 0 auto;">
            Google Reviews van gewaardeerde klanten uit Paterswolde, Eelde, Haren en Groningen.
          </p>
        </div>

        <div class="reviews-dark-grid">
          {reviews.map(r => (
            <div class="review-dark-card">
              <div class="review-dark-stars">★★★★★</div>
              <p class="review-dark-text">"{r.comment}"</p>
              <div class="review-dark-meta">
                <strong class="author-name">{r.author}</strong>
                <span class="treatment-tag">{r.treatment}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 6. Veelgestelde Vragen (Helder Wit) -->
  {siteConfig.modules.faq && (
    <section class="faq-section">
      <div class="container faq-container">
        <div class="section-header text-center">
          <span class="section-tag">Vragen &amp; Antwoorden</span>
          <h2 class="section-title">Veelgestelde Vragen</h2>
          <p class="section-desc" style="max-width: 640px; margin: 0 auto;">
            Alles wat u wilt weten over onze behandelingen, bereikbaarheid en bionome cosmetica.
          </p>
        </div>

        <div class="faq-accordion-wrap">
          {faqs.map((f, index) => (
            <details class="faq-item" open={index === 0}>
              <summary class="faq-question">
                <span>{f.question}</span>
                <span class="faq-arrow">&plus;</span>
              </summary>
              <div class="faq-answer">
                <p>{f.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 7. Chique Donkere Contact CTA Section -->
  <section class="contact-cta-dark-section" id="afspraak">
    <div class="container text-center">
      <div class="cta-dark-box">
        <span class="section-tag tag-dark">Direct Reserveren</span>
        <h2 class="cta-dark-title">Klaar voor een Moment van Pure Verwennerij?</h2>
        <p class="cta-dark-sub">
          Boek vandaag nog uw afspraak en ervaar de serene luxe en persoonlijke aandacht bij Mai Beauty &amp; zo in Paterswolde.
        </p>
        
        <div class="cta-dark-btn-group">
          <a href="/contact#afspraak" class="btn btn-primary btn-cta-main">
            Maak Afspraak &rarr;
          </a>
          <a href="/behandelingen" class="btn btn-dark-outline btn-cta-main">
            Bekijk Prijzen
          </a>
          <a href={"https://wa.me/" + siteConfig.whatsapp + "?text=Hallo%20Aileen,%20ik%20wil%20graag%20een%20afspraak%20maken%20bij%20Mai%20Beauty%20%26%20zo."} target="_blank" rel="noopener noreferrer" class="btn btn-dark-ghost btn-cta-main">
            💬 WhatsApp Afspraak
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding: 4.5rem 0 4.5rem;
    background: linear-gradient(180deg, #FFFFFF 0%, var(--color-background) 100%);
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 4rem;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-secondary);
    background: var(--color-primary);
    padding: 0.35rem 1.1rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.2rem;
  }

  .highlight-text {
    color: var(--color-primary-dark);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 1.8rem;
    max-width: 560px;
  }

  .hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.2rem;
  }

  .h-feat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .feat-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero-image-wrap {
    position: relative;
  }

  .hero-img-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 4px solid #FFFFFF;
  }

  .hero-img {
    width: 100%;
    height: 480px;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .hero-img-card:hover .hero-img {
    transform: scale(1.03);
  }

  .hero-floating-card {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .fl-icon {
    font-size: 1.6rem;
  }

  .hero-floating-card strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-secondary);
  }

  .hero-floating-card span {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  /* 1. Chique Donkere Stats Bar */
  .stats-dark-section {
    background: #181716;
    background-image: radial-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 0);
    background-size: 24px 24px;
    padding: 3.5rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .stats-dark-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
  }

  .stat-dark-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 1.6rem 1.2rem;
    text-align: center;
    backdrop-filter: blur(8px);
    transition: var(--transition);
  }

  .stat-dark-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: var(--color-primary);
    transform: translateY(-3px);
  }

  .stat-dark-num {
    display: block;
    font-family: var(--font-heading);
    font-size: 2.2rem;
    font-weight: 700;
    color: #FFFFFF;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }

  .stat-dark-lbl {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #C5BAAF;
  }

  /* 2. Pillars Section */
  .pillars-section {
    padding: 5.5rem 0;
    background: var(--color-background);
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.2rem;
    margin-top: 3.5rem;
  }

  .pillar-card {
    padding: 2.8rem 2.2rem;
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    text-align: center;
    transition: var(--transition);
  }

  .pillar-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .pillar-icon-wrap {
    width: 60px;
    height: 60px;
    background: var(--color-primary-light);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.5rem;
  }

  .p-icon {
    font-size: 1.8rem;
  }

  .pillar-card h3 {
    font-size: 1.12rem;
    font-weight: 700;
    margin-bottom: 0.8rem;
    color: var(--color-secondary);
  }

  .pillar-card p {
    font-size: 0.92rem;
    color: var(--color-text-secondary);
    line-height: 1.65;
    margin-bottom: 0;
  }

  /* 3. Treatments Showcase */
  .treatments-showcase-section {
    padding: 5.5rem 0;
    background: #FFFFFF;
  }

  .treatments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3rem;
  }

  .treatment-card {
    background: #FAF8F6;
    border-radius: var(--radius-md);
    padding: 2.2rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }

  .treatment-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
    background: #FFFFFF;
  }

  .treatment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .treatment-cat {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-dark);
  }

  .treatment-duration {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .treatment-name {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .treatment-desc {
    font-size: 0.92rem;
    flex: 1;
    margin-bottom: 1.2rem;
  }

  .treatment-hls {
    list-style: none;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .treatment-hls li {
    margin-bottom: 0.3rem;
  }

  .treatment-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
  }

  .treatment-price {
    display: flex;
    flex-direction: column;
  }

  .price-lbl {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: #888;
  }

  .price-val {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .treatments-cta-wrap {
    text-align: center;
    margin-top: 3.5rem;
  }

  /* 4. About Preview */
  .about-preview-section {
    padding: 5.5rem 0;
    background: var(--color-background);
  }

  .about-preview-inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    align-items: center;
    gap: 4.5rem;
  }

  .blob-frame {
    border-radius: 40% 60% 70% 30% / 40% 50% 60% 50%;
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    background: #FFFFFF;
    padding: 8px;
  }

  .about-portrait {
    width: 100%;
    height: 460px;
    object-fit: cover;
    border-radius: inherit;
  }

  .lead-text {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-secondary);
    margin-bottom: 1.2rem;
    border-left: 3px solid var(--color-primary);
    padding-left: 1.2rem;
  }

  .about-checklist {
    margin: 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  /* 5. Chique Donkere Reviews Section */
  .reviews-dark-section {
    background: #181716;
    background-image: radial-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 0);
    background-size: 24px 24px;
    padding: 6rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .tag-dark {
    background: rgba(206, 181, 174, 0.15) !important;
    color: var(--color-primary) !important;
    border: 1px solid rgba(206, 181, 174, 0.3) !important;
  }

  .title-light {
    color: #FFFFFF !important;
  }

  .desc-light {
    color: #B5B5B5 !important;
  }

  .reviews-dark-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-top: 3.5rem;
  }

  .review-dark-card {
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: 2.2rem;
    backdrop-filter: blur(10px);
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }

  .review-dark-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: var(--color-primary);
    transform: translateY(-4px);
  }

