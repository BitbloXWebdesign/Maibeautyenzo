---
import Layout from '../layouts/Layout.astro';
import treatments from '../data/treatments.json';
import products from '../data/products.json';
import reviews from '../data/reviews.json';
import faqs from '../data/faq.json';
import siteConfig from '../../public/site-config.json';

const popularTreatments = treatments.flatMap(cat => 
  cat.items.filter(i => (i as any).popular).map(i => ({ ...i, category: cat.category }))
);
const showcaseProducts = products.slice(0, 4);
---

<Layout title="Mai Beauty & zo — Luxe Schoonheidssalon & Skincare Shop in Paterswolde">
  <!-- Hero Section -->
  <section class="hero-section">
    <div class="container hero-container">
      <div class="hero-content">
        <span class="hero-badge">Ervaring &amp; Kwaliteit</span>
        <h1 class="hero-title">Welkom bij <span class="highlight-text">Mai Beauty &amp; zo</span></h1>
        <p class="hero-subtitle">
          Een moment voor uzelf, waar luxe, ontspanning en gerichte huidverbetering samenkomen in het karakteristieke monumentale kerkgebouw in Paterswolde.
        </p>

        <div class="hero-features">
          <div class="h-feat">
            <span class="feat-dot"></span>
            <span>Premium Behandelingen</span>
          </div>
          <div class="h-feat">
            <span class="feat-dot"></span>
            <span>Persoonlijke Aandacht</span>
          </div>
          <div class="h-feat">
            <span class="feat-dot"></span>
            <span>Dr. Baumann Cosmetica</span>
          </div>
        </div>

        <div class="hero-actions">
          <a href="/contact#afspraak" class="btn btn-primary">Afspraak Inplannen</a>
          <a href="/shop" class="btn btn-outline">Bekijk de Webshop 🛍️</a>
        </div>

        <!-- Trust Stats -->
        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-num">5★</span>
            <span class="stat-lbl">Kwaliteit</span>
          </div>
          <div class="stat-item">
            <span class="stat-num">500+</span>
            <span class="stat-lbl">Tevreden Klanten</span>
          </div>
          <div class="stat-item">
            <span class="stat-num">15+</span>
            <span class="stat-lbl">Behandelingen</span>
          </div>
          <div class="stat-item">
            <span class="stat-num">Bionome</span>
            <span class="stat-lbl">Dr. Baumann Partner</span>
          </div>
        </div>
      </div>

      <div class="hero-image-wrap">
        <div class="hero-img-card">
          <img src="/images/wimpers_en_wenkbrauwen.png" alt="Mai Beauty & zo salon behandeling" class="hero-img" />
          <div class="hero-floating-card">
            <span class="fl-icon">✨</span>
            <div>
              <strong>Pure Verwennerij</strong>
              <span>Paterswolde</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pijlers Section -->
  <section class="pillars-section">
    <div class="container">
      <div class="pillars-grid">
        <div class="pillar-card">
          <div class="pillar-icon">💎</div>
          <h3>Excellence in Vakmanschap</h3>
          <p>Gediplomeerd schoonheidsspecialiste met continue bijscholing in de nieuwste en meest effectieve beautytechnieken.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-icon">🌿</div>
          <h3>Natuurlijke Luxe Producten</h3>
          <p>Uitsluitend hoogwaardige, bionome producten van Dr. Baumann. Vrij van minerale oliën, conserveringsmiddelen en dierproefvrij.</p>
        </div>
        <div class="pillar-card">
          <div class="pillar-icon">🕊️</div>
          <h3>Complete Wellness Ervaring</h3>
          <p>Geniet van de rust en unieke serene sfeer in ons sfeervolle kerkgebouw. Een warm welkom met alle tijd voor u.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Populaire Behandelingen -->
  <section class="treatments-showcase-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Ons Behandelmenu</span>
        <h2 class="section-title">Populaire Behandelingen</h2>
        <p class="section-desc">Van intensieve huidverjongende gezichtsbehandelingen tot verzorgende pedicures en sprekende wimpers.</p>
      </div>

      <div class="treatments-grid">
        {popularTreatments.map(t => (
          <div class="treatment-card">
            <div class="treatment-header">
              <span class="treatment-cat">{t.category}</span>
              <span class="treatment-duration">⏱️ {t.duration}</span>
            </div>
            <h3 class="treatment-name">{t.name}</h3>
            <p class="treatment-desc">{t.description}</p>
            {t.highlights && (
              <ul class="treatment-hls">
                {t.highlights.map(h => (
                  <li>✓ {h}</li>
                ))}
              </ul>
            )}
            <div class="treatment-footer">
              <div class="treatment-price">
                <span class="price-lbl">Vanaf</span>
                <span class="price-val">€ {t.price}</span>
              </div>
              <a href="/contact#afspraak" class="btn btn-primary btn-sm">Afspraak Maken</a>
            </div>
          </div>
        ))}
      </div>

      <div class="treatments-cta-wrap">
        <a href="/behandelingen" class="btn btn-secondary">Bekijk Alle Behandelingen & Prijzen &rarr;</a>
      </div>
    </div>
  </section>

  <!-- Webshop Showcase (4 Bestsellers) -->
  {siteConfig.modules.shop && (
    <section class="shop-showcase-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Dr. Baumann & Skincare</span>
          <h2 class="section-title">Professionele Huidverzorging Webshop</h2>
          <p class="section-desc">Bestel uw favoriete salonproducten eenvoudig online. Afhalen in de salon of direct thuisbezorgd.</p>
        </div>

        <div class="products-grid">
          {showcaseProducts.map(p => (
            <div class="product-card">
              {p.tag && <span class="product-tag">{p.tag}</span>}
              <div class="product-img-wrap">
                <img src={p.image} alt={p.name} class="product-img" />
              </div>
              <div class="product-content">
                <span class="product-cat">{p.category}</span>
                <h4 class="product-title">{p.name}</h4>
                <p class="product-short">{p.shortDescription}</p>
                <div class="product-bottom">
                  <div class="product-price">
                    <span class="current-price">€ {p.price.toFixed(2).replace('.', ',')}</span>
                    {p.oldPrice && <span class="old-price">€ {p.oldPrice.toFixed(2).replace('.', ',')}</span>}
                  </div>
                  <button 
                    class="btn btn-primary btn-sm add-to-cart-btn"
                    data-id={p.id}
                    data-name={p.name}
                    data-price={p.price}
                    data-image={p.image}
                  >
                    + Winkelmand
                  </button>
                </div>
              </div>
            </div>
          ))}
        </div>

        <div class="shop-cta-wrap">
          <a href="/shop" class="btn btn-primary">Naar de Complete Webshop &rarr;</a>
        </div>
      </div>
    </section>
  )}

  <!-- Over Mij Sneak Peek -->
  <section class="about-preview-section">
    <div class="container about-preview-inner">
      <div class="about-img-col">
        <div class="blob-frame">
          <img src="/images/MakeUp.jpeg" alt="Aileen Smith - Schoonheidsspecialiste" class="about-portrait" />
        </div>
      </div>
      <div class="about-text-col">
        <span class="section-tag">Uw Schoonheidsspecialiste</span>
        <h2>Aileen Smith</h2>
        <p class="lead-text">
          "Mijn passie is om iedereen te laten stralen met een gezonde, verzorgde huid en een moment van diepe ontspanning."
        </p>
        <p>
          Sinds april 2021 ben ik met <strong>Mai Beauty &amp; zo</strong> gevestigd in de historische kerk aan de Hoofdweg in Paterswolde. Hier combineer ik persoonlijke aandacht met de beste bionome cosmetica van Dr. Baumann.
        </p>
        <div class="about-checklist">
          <div>✓ Gediplomeerd schoonheidsspecialiste</div>
          <div>✓ Officieel Dr. Baumann verkooppunt</div>
          <div>✓ Vaste persoonlijke behandelaar</div>
        </div>
        <div style="margin-top: 2rem;">
          <a href="/over-ons" class="btn btn-outline">Lees Mijn Verhaal &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews Section -->
  {siteConfig.modules.reviews && (
    <section class="reviews-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">Ervaringen</span>
          <h2 class="section-title">Wat Zeggen Onze Klanten?</h2>
          <p class="section-desc">Google Reviews van gewaardeerde klanten uit Paterswolde, Eelde, Haren en Groningen.</p>
        </div>

        <div class="reviews-grid">
          {reviews.map(r => (
            <div class="review-card">
              <div class="review-stars">★★★★★</div>
              <p class="review-text">"{r.comment}"</p>
              <div class="review-author-meta">
                <strong>{r.author}</strong>
                <span>{r.treatment}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ Section -->
  {siteConfig.modules.faq && (
    <section class="faq-section">
      <div class="container faq-container">
        <div class="section-header">
          <span class="section-tag">Vragen &amp; Antwoorden</span>
          <h2 class="section-title">Veelgestelde Vragen</h2>
          <p class="section-desc">Alles wat u wilt weten over onze behandelingen, bereikbaarheid en cosmetica.</p>
        </div>

        <div class="faq-accordion-wrap">
          {faqs.map((f, index) => (
            <details class="faq-item" open={index === 0}>
              <summary class="faq-question">
                <span>{f.question}</span>
                <span class="faq-arrow">&plus;</span>
              </summary>
              <div class="faq-answer">
                <p>{f.answer}</p>
              </div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Contact CTA Section -->
  <section class="contact-cta-section" id="afspraak">
    <div class="container contact-cta-inner">
      <div class="cta-card">
        <span class="section-tag">Afspraak Maken</span>
        <h2>Klaar voor een Moment van Pure Verwennerij?</h2>
        <p>Neem direct contact op of stuur een bericht via WhatsApp voor de snelste reactie.</p>
        
        <div class="cta-btn-group">
          <a href={"https://wa.me/" + siteConfig.whatsapp + "?text=Hallo%20Aileen,%20ik%20wil%20graag%20een%20afspraak%20maken%20bij%20Mai%20Beauty%20%26%20zo."} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            💬 WhatsApp Afspraak
          </a>
          <a href={"tel:" + siteConfig.phone} class="btn btn-secondary">
            📞 Bel {siteConfig.phoneDisplay}
          </a>
          <a href="/contact" class="btn btn-outline">
            ✉️ Contactformulier
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero-section {
    padding: 4rem 0 5rem;
    background: linear-gradient(180deg, #FFFFFF 0%, var(--color-background) 100%);
    position: relative;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 4rem;
  }

  .hero-badge {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-secondary);
    background: var(--color-primary);
    padding: 0.4rem 1.1rem;
    border-radius: var(--radius-pill);
    margin-bottom: 1.2rem;
  }

  .highlight-text {
    color: var(--color-primary-dark);
  }

  .hero-subtitle {
    font-size: 1.15rem;
    line-height: 1.7;
    margin-bottom: 1.8rem;
    max-width: 560px;
  }

  .hero-features {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2.2rem;
  }

  .h-feat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--color-secondary);
  }

  .feat-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-num {
    font-family: var(--font-heading);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-secondary);
    line-height: 1.1;
  }

  .stat-lbl {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  .hero-image-wrap {
    position: relative;
  }

  .hero-img-card {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
    border: 4px solid #FFFFFF;
  }

  .hero-img {
    width: 100%;
    height: 500px;
    object-fit: cover;
    display: block;
    transition: transform 0.6s ease;
  }

  .hero-img-card:hover .hero-img {
    transform: scale(1.03);
  }

  .hero-floating-card {
    position: absolute;
    bottom: 1.5rem;
    left: 1.5rem;
    background: rgba(255, 255, 255, 0.94);
    backdrop-filter: blur(10px);
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .fl-icon {
    font-size: 1.6rem;
  }

  .hero-floating-card strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-secondary);
  }

  .hero-floating-card span {
    font-size: 0.78rem;
    color: var(--color-text-secondary);
  }

  /* Pillars */
  .pillars-section {
    padding: 4rem 0;
    background: #FFFFFF;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem;
  }

  .pillar-card {
    padding: 2.2rem;
    background: var(--color-background);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    transition: var(--transition);
  }

  .pillar-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .pillar-icon {
    font-size: 2.4rem;
    margin-bottom: 1.2rem;
  }

  .pillar-card h3 {
    font-size: 1.08rem;
    margin-bottom: 0.5rem;
  }

  .pillar-card p {
    font-size: 0.92rem;
    margin-bottom: 0;
  }

  /* Treatments Showcase */
  .treatments-showcase-section {
    padding: 5.5rem 0;
    background: var(--color-background);
  }

  .treatments-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .treatment-card {
    background: #FFFFFF;
    border-radius: var(--radius-md);
    padding: 2rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }

  .treatment-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .treatment-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }

  .treatment-cat {
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-dark);
  }

  .treatment-duration {
    font-size: 0.82rem;
    color: var(--color-text-secondary);
  }

  .treatment-name {
    font-size: 1.1rem;
    margin-bottom: 0.5rem;
  }

  .treatment-desc {
    font-size: 0.92rem;
    flex: 1;
    margin-bottom: 1.2rem;
  }

  .treatment-hls {
    list-style: none;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .treatment-hls li {
    margin-bottom: 0.3rem;
  }

  .treatment-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
  }

  .treatment-price {
    display: flex;
    flex-direction: column;
  }

  .price-lbl {
    font-size: 0.72rem;
    text-transform: uppercase;
    color: #888;
  }

  .price-val {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--color-secondary);
  }

  .treatments-cta-wrap {
    text-align: center;
    margin-top: 3.5rem;
  }

  /* Products Showcase */
  .shop-showcase-section {
    padding: 5.5rem 0;
    background: #FFFFFF;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
  }

  .product-card {
    background: var(--color-background);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: var(--transition);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .product-tag {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    background: var(--color-secondary);
    color: #FFFFFF;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.6rem;
    border-radius: var(--radius-pill);
    z-index: 2;
  }

  .product-img-wrap {
    height: 220px;
    background: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1rem;
  }

  .product-img {
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.06);
  }

  .product-content {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-cat {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-dark);
    font-weight: 600;
    margin-bottom: 0.3rem;
  }

  .product-title {
    font-size: 0.98rem;
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }

  .product-short {
    font-size: 0.85rem;
    flex: 1;
    margin-bottom: 1.2rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .product-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border);
  }

  .current-price {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-secondary);
  }

  .old-price {
    font-size: 0.85rem;
    text-decoration: line-through;
    color: #999;
    margin-left: 0.4rem;
  }

  .shop-cta-wrap {
    text-align: center;
    margin-top: 3.5rem;
  }

  /* About Preview */
  .about-preview-section {
    padding: 5.5rem 0;
    background: var(--color-background);
  }

  .about-preview-inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    align-items: center;
    gap: 4.5rem;
  }

  .about-portrait {
    width: 100%;
    height: 480px;
    object-fit: cover;
  }

  .lead-text {
    font-size: 1.15rem;
    font-style: italic;
    color: var(--color-secondary);
    margin-bottom: 1.2rem;
  }

  .about-checklist {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-weight: 600;
    color: var(--color-secondary);
    margin-top: 1.5rem;
  }

  /* Reviews */
  .reviews-section {
    padding: 5.5rem 0;
    background: #FFFFFF;
  }

  .reviews-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.8rem;
  }

  .review-card {
    background: var(--color-background);
    border-radius: var(--radius-md);
    padding: 1.8rem;
    border: 1px solid var(--color-border);
    display: flex;
    flex-direction: column;
  }

  .review-stars {
    color: #F5A623;
    font-size: 1.2rem;
    margin-bottom: 0.8rem;
  }

  .review-text {
    font-size: 0.9rem;
    font-style: italic;
    flex: 1;
    margin-bottom: 1.2rem;
  }

  .review-author-meta strong {
    display: block;
    font-size: 0.95rem;
    color: var(--color-secondary);
  }

  .review-author-meta span {
    font-size: 0.78rem;
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  /* FAQ */
  .faq-section {
    padding: 5.5rem 0;
    background: var(--color-background);
  }

  .faq-container {
    max-width: 860px;
  }

  .faq-accordion-wrap {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .faq-item {
    background: #FFFFFF;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    transition: var(--transition);
  }

  .faq-item[open] {
    border-color: var(--color-primary);
  }

  .faq-question {
    padding: 1.3rem 1.8rem;
    font-family: var(--font-heading);
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-secondary);
    cursor: pointer;
    display: flex;
