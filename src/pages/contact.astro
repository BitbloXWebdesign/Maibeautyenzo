---
import Layout from '../layouts/Layout.astro';
import siteConfig from '../../public/site-config.json';

const isFormEnabled = siteConfig.modules.form !== false && siteConfig.modules.contactForm !== false;
const isMapsEnabled = siteConfig.modules.maps !== false && siteConfig.modules.googleMaps !== false;
---

<Layout 
  title="Contact & Locatie — Mai Beauty & zo Paterswolde"
  description="Bezoek Mai Beauty & zo in het monumentale kerkgebouw aan de Hoofdweg 164 in Paterswolde. Bel 06-57579694 of stuur direct een WhatsApp bericht."
>
  <div class="page-hero">
    <div class="container text-center">
      <span class="section-tag">Kom Langs &amp; Ontspan</span>
      <h1 class="page-title">Contact &amp; Afspraak Maken</h1>
      <p class="page-subtitle">
        Heeft u vragen over onze behandelingen, cosmetica of wilt u direct een behandeling inplannen? We horen graag van u!
      </p>
    </div>
  </div>

  <section class="contact-main-section">
    <div class={`container contact-grid ${!isFormEnabled ? 'no-form' : ''}`}>
      <!-- Contact Info Cards -->
      <div class="contact-info-col">
        <div class="info-card">
          <span class="c-icon">🏛️</span>
          <div>
            <h3>Onze Locatie</h3>
            <p><strong>{siteConfig.clientName}</strong></p>
            <p>{siteConfig.address.street}</p>
            <p>{siteConfig.address.zip} {siteConfig.address.city}</p>
            <p class="loc-note"><em>{siteConfig.address.locationHint}</em></p>
          </div>
        </div>

        <div class="info-card">
          <span class="c-icon">📞</span>
          <div>
            <h3>Direct Contact</h3>
            <p>Telefoon: <a href={"tel:" + siteConfig.phone}>{siteConfig.phoneDisplay}</a></p>
            <p>WhatsApp: <a href={"https://wa.me/" + siteConfig.whatsapp} target="_blank" rel="noopener noreferrer">Stuur direct een appje</a></p>
            <p>E-mail: <a href={"mailto:" + siteConfig.email}>{siteConfig.email}</a></p>
          </div>
        </div>

        <div class="info-card">
          <span class="c-icon">🕒</span>
          <div>
            <h3>Openingstijden</h3>
            <ul class="hours-list">
              {siteConfig.openingHours.map(h => (
                <li>
                  <span class="day-lbl">{h.days}</span>
                  <span class="hour-val">{h.hours}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        {!isFormEnabled && (
          <div class="info-card direct-call-card" style="background: var(--color-primary-light); border: 1px solid rgba(var(--color-primary-rgb), 0.3);">
            <span class="c-icon">✨</span>
            <div>
              <h3>Afspraak Maken</h3>
              <p>Voor vragen of het direct inplannen van een behandeling kunt u bellen naar <a href={"tel:" + siteConfig.phone}><strong>{siteConfig.phoneDisplay}</strong></a> of een WhatsApp bericht sturen.</p>
              <div style="margin-top: 1rem; display: flex; gap: 0.8rem; flex-wrap: wrap;">
                <a href={"https://wa.me/" + siteConfig.whatsapp} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-sm">💬 WhatsApp Bericht</a>
                <a href={"tel:" + siteConfig.phone} class="btn btn-outline btn-sm">📞 Direct Bellen</a>
              </div>
            </div>
          </div>
        )}

        <div class="parking-card">
          <h4>🚗 Parkeren &amp; Bereikbaarheid</h4>
          <p>Er is ruime en gratis parkeergelegenheid direct naast de deur bij de Albert Heijn en Etos.</p>
        </div>
      </div>

      <!-- Contact Form -->
      {isFormEnabled && (
        <div class="contact-form-col">
          <div class="form-container-card" id="afspraak">
            <span class="form-badge">Online Aanvraag</span>
            <h2>Stuur een Bericht</h2>
            <p>Vul het formulier in voor een vraag of behandelverzoek. We reageren altijd snel.</p>

            <form class="main-contact-form" id="contact-form" action="https://api.web3forms.com/submit" method="POST">
              <input type="hidden" name="access_key" value="00000000-0000-0000-0000-000000000000" />
              <input type="hidden" name="subject" value="Nieuwe aanvraag via Mai Beauty &amp; zo website" />
              <input type="hidden" name="from_name" value="Mai Beauty &amp; zo Contactformulier" />

              <div class="form-row">
                <div class="form-field">
                  <label for="f-name">Uw Naam *</label>
                  <input type="text" id="f-name" name="name" required placeholder="bijv. Marloes Jansen" />
                </div>
                <div class="form-field">
                  <label for="f-phone">Telefoonnummer *</label>
                  <input type="tel" id="f-phone" name="phone" required placeholder="bijv. 06 12345678" />
                </div>
              </div>

              <div class="form-field">
                <label for="f-email">E-mailadres *</label>
                <input type="email" id="f-email" name="email" required placeholder="uw@email.nl" />
              </div>

              <div class="form-field">
                <label for="f-service">Gewenste Behandeling / Onderwerp</label>
                <select id="f-service" name="service">
                  <option value="Beauty Treatment Gezicht">Beauty Treatment Gezicht (30, 60 of 90 min)</option>
                  <option value="Pedicure Behandeling">Pedicure Behandeling</option>
                  <option value="Wimpers &amp; Wenkbrauwen">Wimpers &amp; Wenkbrauwen</option>
                  <option value="Dr. Baumann Cosmetica Bestellen">Dr. Baumann Cosmetica Bestellen</option>
                  <option value="Bruidsmake-up">Bruidsmake-up</option>
                  <option value="Algemene vraag">Algemene vraag</option>
                </select>
              </div>

              <div class="form-field">
                <label for="f-message">Uw Bericht of Voorkeursdag *</label>
                <textarea id="f-message" name="message" rows="4" required placeholder="Geef eventueel uw voorkeursdatum of vraag aan..."></textarea>
              </div>

              <button type="submit" class="btn btn-primary" style="width: 100%;">Verstuur Aanvraag</button>
              <div id="form-result" class="form-result-msg"></div>
            </form>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- Interactive Map Section -->
  {isMapsEnabled && (
    <section class="map-section">
      <div class="container">
        <div class="map-wrap">
          <iframe 
            src="https://maps.google.com/maps?q=Hoofdweg%20164%2C%209765%20CL%20Paterswolde&t=&z=15&ie=UTF8&iwloc=&output=embed"
            width="100%" 
            height="400" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy"
            title="Google Maps Locatie Mai Beauty &amp; zo"
          ></iframe>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .page-hero {
    background: linear-gradient(180deg, #FFFFFF 0%, var(--color-background) 100%);
    padding: 4.5rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-subtitle {
    max-width: 650px;
    margin: 0 auto;
    font-size: 1.1rem;
  }

  .contact-main-section {
    padding: 5rem 0;
    background: var(--color-background);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 3.5rem;
  }

  .contact-grid.no-form {
    grid-template-columns: 1fr;
    max-width: 680px;
    margin: 0 auto;
  }

  .contact-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .info-card {
    background: #FFFFFF;
    border-radius: var(--radius-md);
    padding: 1.8rem;
    border: 1px solid var(--color-border);
    display: flex;
    gap: 1.2rem;
    box-shadow: var(--shadow-sm);
  }

  .c-icon {
    font-size: 2rem;
  }

  .info-card h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }

  .info-card p {
    margin-bottom: 0.2rem;
    font-size: 0.92rem;
  }

  .loc-note {
    color: var(--color-primary-dark);
    margin-top: 0.4rem;
    font-size: 0.85rem;
  }

  .hours-list {
    list-style: none;
    font-size: 0.88rem;
  }

  .hours-list li {
    display: flex;
    justify-content: space-between;
    padding: 0.3rem 0;
    border-bottom: 1px dashed var(--color-border);
  }

  .parking-card {
    background: var(--color-primary-light);
    border: 1px solid rgba(var(--color-primary-rgb), 0.3);
    border-radius: var(--radius-md);
    padding: 1.4rem;
  }

  .parking-card h4 {
    font-size: 0.95rem;
    margin-bottom: 0.4rem;
  }

  .parking-card p {
    font-size: 0.85rem;
    margin-bottom: 0;
  }

  /* Form Card */
  .form-container-card {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    padding: 3rem;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    position: relative;
  }

  .form-badge {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-primary-dark);
    margin-bottom: 0.5rem;
  }

  .form-container-card h2 {
    font-size: 1.8rem;
    margin-bottom: 0.4rem;
  }

  .form-container-card p {
    font-size: 0.92rem;
    margin-bottom: 1.8rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-field {
    margin-bottom: 1.2rem;
  }

  .form-field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-secondary);
    margin-bottom: 0.35rem;
  }

  .form-field input,
  .form-field select,
  .form-field textarea {
    width: 100%;
    padding: 0.8rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 0.95rem;
    outline: none;
    transition: var(--transition);
  }

  .form-field input:focus,
  .form-field select:focus,
  .form-field textarea:focus {
    border-color: var(--color-primary-dark);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.2);
  }

  .form-result-msg {
    margin-top: 1rem;
    font-size: 0.9rem;
    text-align: center;
    font-weight: 600;
  }

  /* Map */
  .map-section {
    padding-bottom: 5rem;
    background: var(--color-background);
  }

  .map-wrap {
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-md);
    border: 1px solid var(--color-border);
  }

  @media (max-width: 992px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
    .form-container-card {
      padding: 2rem;
    }
    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const result = document.getElementById('form-result');

  form?.addEventListener('submit', async function(e) {
    e.preventDefault();
    const formData = new FormData(form);

    if (result) {
      result.innerHTML = "Even geduld a.u.b...";
      result.style.color = "#5A5A5A";
    }

    const payload = {
      to: 'info@maibeautyenzo.nl',
      name: formData.get('name'),
      phone: formData.get('phone'),
      email: formData.get('email'),
      service: formData.get('service'),
      message: formData.get('message'),
      domain: 'maibeautyenzo.nl',
      clientName: 'Mài Beauty & zo'
    };

    try {
      let response = await fetch('https://bitblox.nl/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload)
      }).catch(() => null);

      if (!response || !response.ok) {
        response = await fetch(`https://formsubmit.co/ajax/info@maibeautyenzo.nl`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify({
            _subject: `📩 Nieuw contactbericht via ${payload.domain}`,
            Naam: payload.name,
            'E-mailadres': payload.email,
            Telefoonnummer: payload.phone,
            Dienst: payload.service,
            Bericht: payload.message,
            _replyto: payload.email,
            _template: 'table'
          })
        });
      }

      const json = await response.json();
      if (response.status === 200 || json.success) {
        if (result) {
          result.innerHTML = "✅ Bedankt! Uw aanvraag is succesvol verzonden. We nemen snel contact op.";
          result.style.color = "#2E7D32";
        }
        form.reset();
      } else {
        throw new Error('Fallback to WhatsApp');
      }
    } catch(err) {
      const name = formData.get('name');
      const phone = formData.get('phone');
      const msg = formData.get('message');
      const waUrl = `https://wa.me/31657579694?text=${encodeURIComponent('Aanvraag van ' + name + ' (' + phone + '): ' + msg)}`;
      window.open(waUrl, '_blank');
      if (result) {
        result.innerHTML = "✅ Uw bericht is geopend in WhatsApp!";
        result.style.color = "#25D366";
      }
    }
  });
</script>
