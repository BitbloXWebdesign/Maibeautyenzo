    "title": "Welke Gezichtsbehandeling Past het Beste bij Jouw Huid? (30, 60 of 90 min)",
    "category": "Salon Behandelingen",
    "date": "8 maart 2026",
    "readTime": "5 min leestijd",
    "image": "/images/hero-luxury.jpg",
