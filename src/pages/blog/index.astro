---

<Layout 
  title="Kennisbank & Huidadvies — Mai Beauty & zo Paterswolde"
  description="Lees artikelen, beautytips en diepgaande kennis over Dr. Baumann bionome cosmetica, gezichtsbehandelingen en pedicure in Paterswolde."
>
  <div class="page-hero">
    <div class="container text-center">
      <span class="section-tag">Kennis &amp; Inspiratie</span>
      <h1 class="page-title">Beauty &amp; Skincare Kennisbank</h1>
      <p class="page-subtitle">
        Deskundig huidadvies, wetenschappelijke inzichten over bionome cosmetica en praktische tips voor een gezonde, stralende huid.
      </p>
    </div>
  </div>

  <section class="blog-list-section">
    <div class="container">
      <div class="articles-grid">
        {articlesList.map(a => (
          <article class="article-card">
            <div class="article-img-wrap">
              <span class="card-cat-badge">{a.category}</span>
              <img src={a.image} alt={a.title} class="article-img" />
            </div>
            <div class="article-body">
              <div class="article-meta">
                <span>📅 {a.date}</span>
                <span>⏱️ {a.readTime}</span>
              </div>
              <h2 class="article-title">
                <a href={"/blog/" + a.slug}>{a.title}</a>
              </h2>

              <div class="article-card-summary">
                <p>{a.summary}</p>
              </div>

              <a href={"/blog/" + a.slug} class="read-more-btn">
                Lees Artikel &rarr;
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    background: linear-gradient(180deg, #FFFFFF 0%, var(--color-background) 100%);
    padding: 3.5rem 0 2.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .page-subtitle {
    max-width: 620px;
    margin: 0 auto;
    font-size: 1.05rem;
  }

  .blog-list-section {
    padding: 3.5rem 0 5rem;
    background: var(--color-background);
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
  }

  .article-card {
    background: #FFFFFF;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transition: var(--transition);
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .article-img-wrap {
    height: 190px;
    overflow: hidden;
    position: relative;
  }

  .card-cat-badge {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(6px);
    color: var(--color-secondary);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    z-index: 2;
  }

  .article-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .article-card:hover .article-img {
    transform: scale(1.05);
  }

  .article-body {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .article-meta {
    display: flex;
    gap: 0.8rem;
    font-size: 0.75rem;
    color: var(--color-text-secondary);
    margin-bottom: 0.5rem;
  }

  .article-title {
    font-size: 0.98rem;
    margin-bottom: 0.5rem;
    line-height: 1.35;
  }

  .article-title a {
    color: var(--color-secondary);
  }

  .article-title a:hover {
    color: var(--color-primary-dark);
  }

  .article-card-summary {
    font-size: 0.84rem;
    line-height: 1.55;
    color: var(--color-text-secondary);
    flex: 1;
    margin-bottom: 1.2rem;
  }

  .read-more-btn {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--color-primary-dark);
    display: inline-block;
    transition: var(--transition);
  }

  .read-more-btn:hover {
    color: var(--color-secondary);
    transform: translateX(3px);
  }

  @media (max-width: 992px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .articles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
