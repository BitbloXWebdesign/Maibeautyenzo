---
import Layout from '../../layouts/Layout.astro';
import products from '../../data/products.json';
import siteConfig from '../../../public/site-config.json';

if (!siteConfig.modules.shop) {
  return Astro.redirect('/');
}

const categories = ['Alles', 'Dr. Baumann', 'Gezichtsverzorging', 'Serums & Olie', 'Cadeaubonnen'];
---

<Layout 
  title="Webshop & Skincare — Mai Beauty & zo Paterswolde"
  description="Bestel officiële Dr. Baumann bionome huidverzorgingsproducten, serums en salon cadeaubonnen in de webshop van Mai Beauty & zo."
  isShopPage={true}
>
  <!-- Shop Hero Section: Beautiful Side-by-Side Layout -->
  <section class="shop-hero">
    <div class="container shop-hero-container">
      <div class="shop-hero-left">
        <span class="section-tag">Dr. Baumann Bionome Kwaliteit</span>
        <h1 class="shop-title">Mai Skincare Webshop</h1>
        <p class="shop-hero-sub">
          100% Huidvriendelijke en effectieve bionome cosmetica. Vrij van minerale oliën en chemische conserveringsmiddelen. Bestel direct online of haal gratis af in onze salon in Paterswolde.
        </p>
      </div>

      <div class="shop-hero-right">
        <!-- Search Box -->
        <div class="hero-search-box">
          <span class="search-ico">🔍</span>
          <input 
            type="text" 
            id="shop-search-input" 
            placeholder="Zoek product, ingrediënt of type..." 
            aria-label="Zoeken in webshop"
          />
          <button id="clear-search-btn" class="clear-search" aria-label="Wissen">&times;</button>
        </div>

        <div class="shop-trust-badges">
          <span class="trust-pill">✓ Gratis afhalen in salon</span>
          <span class="trust-pill">✓ PostNL thuisbezorgd</span>
          <span class="trust-pill">✓ Persoonlijk huidadvies</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Category Filter Tabs -->
  <section class="shop-filter-bar">
    <div class="container">
      <div class="filter-tabs-wrapper">
        {categories.map((cat, idx) => (
          <button 
            class={idx === 0 ? 'category-tab active' : 'category-tab'} 
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- Products Main Grid -->
  <section class="shop-products-section">
    <div class="container">
      <div class="shop-results-meta">
        <span id="results-count">Toont alle {products.length} producten</span>
        <span class="guarantee-badge">🔒 100% Veilige iDEAL &amp; WhatsApp Bestelling</span>
      </div>

      <div class="products-grid" id="shop-products-grid">
        {products.map(p => (
          <div class="product-card" data-category={p.category} data-name={p.name.toLowerCase()} data-id={p.id}>
            {p.tag && <span class="product-tag">{p.tag}</span>}
            <div class="product-img-wrap">
              <img src={p.image} alt={p.name} class="product-img" />
            </div>
            <div class="product-content">
              <span class="product-cat">{p.category}</span>
              <h3 class="product-title">{p.name}</h3>
              <div class="product-volume-meta">Inhoud: {p.volume}</div>
              <p class="product-short">{p.shortDescription}</p>

              <div class="product-bottom">
                <div class="product-price">
                  <span class="current-price">€ {p.price.toFixed(2).replace('.', ',')}</span>
                  {p.oldPrice && <span class="old-price">€ {p.oldPrice.toFixed(2).replace('.', ',')}</span>}
                </div>
                <button 
                  class="btn btn-primary btn-sm add-to-cart-btn"
                  data-id={p.id}
                  data-name={p.name}
                  data-price={p.price}
                  data-image={p.image}
                  type="button"
                >
                  + In Winkelmand
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="no-results-box" id="no-results" style="display: none;">
        <span class="no-res-icon">🔍</span>
        <h3>Geen producten gevonden</h3>
        <p>Probeer een andere zoekterm of categorie.</p>
        <button class="btn btn-outline" id="reset-filter-btn">Toon alle artikelen</button>
      </div>

      <!-- Dr. Baumann Bionome Promise Banner -->
      <div class="bionome-banner">
        <div class="bionome-grid">
          <div class="bionome-item">
            <span class="bio-ico">🌿</span>
            <strong>Zonder Parabenen</strong>
            <span>Geen chemische conservering</span>
          </div>
          <div class="bionome-item">
            <span class="bio-ico">💧</span>
            <strong>Huididentieke Lipiden</strong>
            <span>Optimale tolerantie &amp; diepe opname</span>
          </div>
          <div class="bionome-item">
            <span class="bio-ico">🐰</span>
            <strong>100% Dierproefvrij</strong>
            <span>Ethisch &amp; verantwoord (vegan)</span>
          </div>
          <div class="bionome-item">
            <span class="bio-ico">🛡️</span>
            <strong>Geen Minerale Oliën</strong>
            <span>Laat de poriën vrij ademen</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Side-by-Side Shop Hero */
  .shop-hero {
    background: linear-gradient(180deg, #FFFFFF 0%, var(--color-background) 100%);
    padding: 2.8rem 0 2.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .shop-hero-container {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 3rem;
  }

  .shop-hero-left {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .shop-title {
    font-size: 1.55rem;
    margin-bottom: 0.4rem;
    color: var(--color-secondary);
  }

  .shop-hero-sub {
    font-size: 0.94rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin-bottom: 0;
    max-width: 580px;
  }

  .shop-hero-right {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .hero-search-box {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .hero-search-box input {
    width: 100%;
    padding: 0.8rem 2.6rem 0.8rem 2.6rem;
    font-family: var(--font-body);
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: #FFFFFF;
    color: var(--color-text-primary);
    box-shadow: var(--shadow-sm);
    outline: none;
    transition: var(--transition);
  }

  .hero-search-box input:focus {
    border-color: var(--color-primary-dark);
    box-shadow: 0 0 0 3px rgba(var(--color-primary-rgb), 0.25);
  }

  .search-ico {
    position: absolute;
    left: 1rem;
    font-size: 0.9rem;
    pointer-events: none;
    color: #888;
  }

  .clear-search {
    position: absolute;
    right: 0.9rem;
    background: transparent;
    border: none;
    color: #999;
    font-size: 1.2rem;
    cursor: pointer;
    display: none;
    line-height: 1;
  }

  .shop-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .trust-pill {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    background: #FFFFFF;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-border);
  }

  /* Filter tabs */
  .shop-filter-bar {
    background: #FFFFFF;
    border-bottom: 1px solid var(--color-border);
    padding: 0.85rem 0;
    position: sticky;
    top: 73px;
    z-index: 900;
  }

  .filter-tabs-wrapper {
    display: flex;
    justify-content: flex-start;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.1rem;
  }

  .category-tab {
    background: var(--color-background);
    color: var(--color-secondary);
    border: 1px solid var(--color-border);
    padding: 0.45rem 1.1rem;
    border-radius: var(--radius-pill);
    font-family: var(--font-heading);
    font-size: 0.84rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: var(--transition);
  }

  .category-tab:hover,
  .category-tab.active {
    background: var(--color-secondary);
    color: #FFFFFF;
    border-color: var(--color-secondary);
  }

  .shop-products-section {
    padding: 3rem 0 5rem;
    background: var(--color-background);
  }

  .shop-results-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.8rem;
    font-size: 0.85rem;
    color: var(--color-text-secondary);
  }

  .guarantee-badge {
    color: var(--color-primary-dark);
    font-weight: 600;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.8rem;
  }

  .product-card {
    background: #FFFFFF;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    box-shadow: var(--shadow-sm);
    transition: var(--transition);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--color-primary);
  }

  .product-tag {
    position: absolute;
    top: 0.8rem;
    left: 0.8rem;
    background: var(--color-secondary);
    color: #FFFFFF;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.2rem 0.55rem;
    border-radius: var(--radius-pill);
    z-index: 2;
  }

  .product-img-wrap {
    height: 220px;
    background: #FAFAFA;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 1.2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .product-img {
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.06);
  }

  .product-content {
    padding: 1.4rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-cat {
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-primary-dark);
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .product-title {
    font-size: 0.98rem;
    margin-bottom: 0.3rem;
    line-height: 1.3;
  }

  .product-volume-meta {
    font-size: 0.75rem;
    color: #888;
    margin-bottom: 0.6rem;
  }

  .product-short {
    font-size: 0.85rem;
    flex: 1;
    margin-bottom: 1.2rem;
    line-height: 1.5;
  }

  .product-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-border);
  }

  .current-price {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--color-secondary);
  }

  .old-price {
    font-size: 0.82rem;
    text-decoration: line-through;
    color: #999;
    margin-left: 0.4rem;
  }

  .no-results-box {
    text-align: center;
    padding: 3.5rem 1rem;
    background: #FFFFFF;
    border-radius: var(--radius-md);
    border: 1px dashed var(--color-border);
  }

  .no-res-icon {
    font-size: 2.5rem;
    display: block;
    margin-bottom: 0.8rem;
  }

  /* Bionome Banner */
  .bionome-banner {
    background: #FFFFFF;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    padding: 2rem;
    margin-top: 3.5rem;
  }

  .bionome-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .bionome-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .bio-ico {
    font-size: 1.8rem;
    margin-bottom: 0.4rem;
  }

  .bionome-item strong {
    font-size: 0.9rem;
    color: var(--color-secondary);
    margin-bottom: 0.15rem;
  }

  .bionome-item span {
    font-size: 0.75rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 992px) {
    .shop-hero-container {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }
    .products-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bionome-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 600px) {
    .products-grid {
      grid-template-columns: 1fr;
    }
    .bionome-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // 0ms Instant Client Search & Category Filter
  const tabs = document.querySelectorAll('.category-tab');
  const searchInput = document.getElementById('shop-search-input') as HTMLInputElement;
  const clearBtn = document.getElementById('clear-search-btn');
  const productCards = document.querySelectorAll('.product-card');
  const resultsCount = document.getElementById('results-count');
  const noResults = document.getElementById('no-results');
  const resetBtn = document.getElementById('reset-filter-btn');

  let activeCategory = 'Alles';

  function filterProducts() {
    const query = searchInput ? searchInput.value.toLowerCase().trim() : '';
    if (clearBtn) {
      clearBtn.style.display = query ? 'block' : 'none';
    }

    let visibleCount = 0;

    productCards.forEach((card: any) => {
      const cat = card.getAttribute('data-category');
      const name = card.getAttribute('data-name');
      const matchesCategory = (activeCategory === 'Alles') || (cat === activeCategory);
      const matchesSearch = !query || name.includes(query) || (cat && cat.toLowerCase().includes(query));

      if (matchesCategory && matchesSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (resultsCount) {
      resultsCount.textContent = `Toont ${visibleCount} product${visibleCount === 1 ? '' : 'en'}`;
    }

    if (noResults) {
      noResults.style.display = visibleCount === 0 ? 'block' : 'none';
    }
  }

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      tab.classList.add('active');
      activeCategory = tab.getAttribute('data-category') || 'Alles';
      filterProducts();
    });
  });

  searchInput?.addEventListener('input', filterProducts);
  clearBtn?.addEventListener('click', () => {
    searchInput.value = '';
    filterProducts();
  });

  resetBtn?.addEventListener('click', () => {
    if (searchInput) searchInput.value = '';
    activeCategory = 'Alles';
    tabs.forEach(t => t.classList.toggle('active', t.getAttribute('data-category') === 'Alles'));
    filterProducts();
  });
</script>
